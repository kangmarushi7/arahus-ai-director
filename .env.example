# Arahus AI Director — environment template (no secrets)
# Copy to `.env` or `.ENV` and fill in values.

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model precedence (per task):
#   1) Explicit LLMClient.model argument
#   2) Env override below (if non-empty)
#   3) src/llm/configs/router.yaml task route
RESEARCH_MODEL=
DIRECTOR_MODEL=
PROMPT_MODEL=
REVIEW_MODEL=
DOMAIN_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
LLM_CACHE_ENABLED=true

# --- Pipeline ---
MAX_STORYBOARD_RETRIES=3
REVIEW_APPROVAL_THRESHOLD=85
AGENT_DEBUG=false
PROMPT_OPTIMIZER_ENABLED=true
PIPELINE_MAX_COST_USD=0
IMAGE_MAX_WORKERS=6
ALLOW_STUB_SERVICES=false

# --- API security ---
# When set, REST requires Authorization: Bearer <key> or X-API-Key.
# Leave empty for local/dev only. WebSocket: /ws/...?api_key=<key>
ARAHUS_API_KEY=
# Comma-separated origins. Use * only without credentials (not recommended).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_DOCS_ENABLED=true

# --- RunPod images (FLUX.1 Dev) ---
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_BASE_URL=https://api.runpod.ai/v2
IMAGE_MODEL_ID=black-forest-labs/FLUX.1-dev
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_NUM_INFERENCE_STEPS=28
IMAGE_GUIDANCE_SCALE=3.5
HF_TOKEN=

# --- RunPod video (Wan 2.1) ---
RUNPOD_VIDEO_ENDPOINT_ID=

# --- Cloudflare R2 ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# --- Database ---
DATABASE_URL=

# --- Monitoring ---
METRICS_ENABLED=true
METRICS_INCLUDE_SAMPLES=false
METRICS_EXPORT_PATH=
