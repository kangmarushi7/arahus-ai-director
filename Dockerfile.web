# Slim web image for Arahus Lab (Streamlit) on Railway / any VPS.
# Does NOT include torch/diffusers — image gen stays on RunPod.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app

COPY requirements.web.txt .
RUN python -m pip install --no-cache-dir --requirement requirements.web.txt

COPY app/ ./app/
COPY src/ ./src/
COPY alembic/ ./alembic/
COPY alembic.ini .
COPY scripts/ ./scripts/
COPY .env.example .

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/.cache \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8501

# Railway injects PORT; default 8501 for local docker runs.
CMD ["sh", "-c", "streamlit run app/lab.py --server.address 0.0.0.0 --server.port ${PORT:-8501} --server.headless true"]
